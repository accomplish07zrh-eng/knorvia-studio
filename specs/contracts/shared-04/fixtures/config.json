  "dynamicWorkflow": {
    "modes": ["disabled", "onDemand", "alwaysOn"],
    "defaultMode": "disabled",
    "envKey": "KNORVIA_DYNAMIC_WORKFLOW_MODE",
    "resolve": [
      {
        "input": {
          "remote": {
            "mode": "onDemand"
          },
          "env": {}
        },
        "output": {
          "mode": "onDemand",
          "enabled": true,
          "source": "remote"
        }
      },
      {
        "input": {
          "remote": {
            "mode": "bogus"
          },
          "env": {
            "KNORVIA_DYNAMIC_WORKFLOW_MODE": " alwaysOn "
          }
        },
        "output": {
          "mode": "alwaysOn",
          "enabled": true,
          "source": "override"
        }
      },
      {
        "input": {
          "remote": null,
          "env": {
            "KNORVIA_DYNAMIC_WORKFLOW_MODE": "bogus"
          }
        },
        "output": {
          "mode": "disabled",
          "enabled": false,
          "source": "default"
        }
      },
      {
        "input": {
          "remote": {},
          "env": {}
        },
        "output": {
          "mode": "disabled",
          "enabled": false,
          "source": "default"
        }
      },
      {
        "input": {
          "remote": {
            "mode": "alwaysOn"
          },
          "env": {
            "KNORVIA_DYNAMIC_WORKFLOW_MODE": "disabled"
          }
        },
        "output": {
          "mode": "disabled",
          "enabled": false,
          "source": "override"
        }
      },
      {
        "input": {
          "remote": {
            "mode": "disabled"
          },
          "env": {}
        },
        "output": {
          "mode": "disabled",
          "enabled": false,
          "source": "remote"
        }
      }
    ],
    "normalize": [
      {
        "input": " disabled ",
        "output": "disabled"
      },
      {
        "input": "onDemand",
        "output": "onDemand"
      },
      {
        "input": "alwaysOn",
        "output": "alwaysOn"
      },
      {
        "input": "bogus"
      },
      {
        "input": 1
      },
      {
        "input": null
      }
    ],
    "enabled": [
      {
        "input": "disabled",
        "output": false
      },
      {
        "input": "onDemand",
        "output": true
      },
      {
        "input": "alwaysOn",
        "output": true
      },
      {
        "input": "bogus",
        "output": true
      }
    ],
    "client": {
      "mode": "alwaysOn",
      "enabled": true
    }
  },
