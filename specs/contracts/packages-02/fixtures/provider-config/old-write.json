{
  "schemaVersion": 1,
  "config": {
    "providerOrder": [
      "personal-openai",
      "personal-empty"
    ],
    "providerConfigRules": {
      "providerRules": [
        {
          "providerId": "personal-openai",
          "config": {
            "personalModelIds": [
              "gpt-x",
              "legacy-manual"
            ],
            "modelOrder": [
              "gpt-x",
              "legacy-manual"
            ],
            "visibility": "visible"
          }
        },
        {
          "providerId": "personal-empty",
          "config": {
            "visibility": "visible"
          }
        }
      ]
    },
    "modelConfigRules": {
      "providerModelRules": [
        {
          "modelId": "gpt-x",
          "config": {
            "enabled": true,
            "optionSpecs": {
              "reasoningLevel": {
                "values": [
                  "off",
                  "high"
                ]
              }
            }
          },
          "providerId": "personal-openai"
        }
      ],
      "manualProviderModelRules": [
        {
          "modelId": "legacy-manual",
          "config": {
            "enabled": false,
            "properties": {
              "contextWindow": 12345,
              "supportsJsonSchemaOutput": false,
              "supportsNativeWebSearch": true,
              "supportsMidConversationSystem": false,
              "inputFormat": {
                "supportsImage": true,
                "supportsVideo": false,
                "supportsPdf": false
              }
            },
            "optionSpecs": {
              "reasoningLevel": {
                "values": [
                  "synthetic-low",
                  "synthetic-high"
                ],
                "map": "{\"synthetic_reasoning\": reasoningLevel}"
              },
              "maxOutputTokens": {
                "max": 321
              }
            }
          },
          "providerId": "personal-openai"
        }
      ]
    },
    "defaultModelSelection": {
      "providerId": "personal-openai",
      "modelId": "gpt-x",
      "options": {
        "reasoningLevel": "high"
      }
    }
  }
}