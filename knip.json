{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": [
        ".release-it.mjs",
        ".vscode/*.mjs",
        "scripts/check-workspace-freshness.mjs",
        "scripts/mise-run.mjs",
        "specs/contracts/*/tests/*.test.ts",
        "specs/contracts/*/tests/run-old-gate.mjs",
        "specs/contracts/*/dist-entry-loader.mjs",
        "scripts/provenance/inherited-triage.mjs",
        "scripts/provenance/inherited-triage.test.mjs",
        "scripts/generate-knorvia-notification-sound.mjs",
        "scripts/contract-gate.mjs",
        "scripts/contract-gate.test.mjs",
        "scripts/contract-test-discovery.mjs",
        "scripts/contract-test-discovery.test.mjs",
        "scripts/kernel-context-probe.mjs",
        "scripts/kernel-shell-probe.mjs",
        "scripts/provenance/similarity.mjs",
        "scripts/provenance/similarity.test.mjs",
        "scripts/provenance/bookkeeping-round2.mjs",
        "scripts/provenance/bookkeeping-round2-similarity.mjs",
        "specs/contracts/core-hooks/tests/run-old-gate.mjs",
        "specs/contracts/dynamic-workflow-01/tests/record-golden.mjs",
        "specs/contracts/dynamic-workflow-01/tests/gen-interface.mjs",
        "specs/contracts/dynamic-workflow-01/tests/scan-callers.mjs",
        "specs/contracts/dynamic-workflow-02/tests/record-golden.mjs",
        "specs/contracts/dynamic-workflow-02/tests/gen-interface.mjs",
        "specs/contracts/dynamic-workflow-02/tests/record-facade.mjs",
        "specs/contracts/dynamic-workflow-02/tests/scan-callers.mjs",
        "specs/contracts/dynamic-workflow-02/tests/harness.mjs",
        "specs/contracts/dynamic-workflow-02/tests/scope.mjs",
        "specs/contracts/dynamic-workflow-02/tests/exports-ast.mjs"
      ]
    },
    "packages/desktop": {
      "entry": [
        "electron-builder.config.js",
        "scripts/sign-windows-hook.cjs",
        "src/renderer/*.html",
        "src/renderer/cuaPermissionPanel.ts",
        "src/renderer/src/resource-manager.tsx"
      ]
    },
    "packages/server": {
      "entry": ["src/index.ts", "src/entry-stdio.ts", "build-remote.ts"]
    },
    "packages/services": {
      "entry": ["src/index.ts", "src/storage/module.ts"]
    },
    "apps/cli/packages/browser-use-plugin": {
      "entry": ["src/browser-client.ts"]
    },
    "packages/ui": {
      "entry": ["test/knorvia-notification-sound.test.ts"]
    },
    "apps/cli/packages/core": {
      "entry": [
        "test/core-hooks-entry.mjs",
        "test/fixtures/core-hooks-builders.mjs",
        "src/runtime/helpers/{attachments,media,permission,steering,runtime-reminders,session,compact,model,turn,provider,tooling,memory,context}/**"
      ]
    }
  },
  "ignore": [".agents/**", "docs/**", "packages/ui/src/components/**", "specs/contracts/*/stubs/**"]
}
