      "kind": "template",
      "head": "<!doctype html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta\n      http-equiv=\"Content-Security-Policy\"\n      content=\"default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'\"\n    />\n    <title>",
      "spans": [
        {
          "placeholder": "VALUE_1",
          "text": "</title>\n    <style>\n      :root {\n        color-scheme: light dark;\n        font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", sans-serif;\n        --startup-page-bg: #f4f4f5;\n        --about-primary: #0a0a0a;\n        --about-primary-foreground: #fafafa;\n        --about-primary-active: color-mix(in oklab, var(--about-primary) 80%, transparent);\n      }\n\n      * {\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 100%;\n        height: 100%;\n        margin: 0;\n        overflow: hidden;\n        background: var(--startup-page-bg);\n      }\n\n      body {\n        display: grid;\n        place-items: center;\n        padding: 0;\n        user-select: none;\n      }\n\n      .about-window {\n        width: 100%;\n        max-width: 256px;\n        height: 280px;\n        display: grid;\n        place-items: stretch;\n        padding: 0;\n        background: transparent;\n      }\n\n      .about-card {\n        width: 100%;\n        height: 100%;\n        padding: 22px 15px 14px;\n        display: flex;\n        flex-direction: column;\n        border: 0;\n        border-radius: 0;\n        background: transparent;\n        color: #1d1d1f;\n        box-shadow: none;\n        -webkit-app-region: drag;\n      }\n\n      .content {\n        width: 100%;\n        max-width: 222px;\n        margin: 0 auto;\n        flex: 1;\n        min-height: 0;\n      }\n\n      .app-icon {\n        width: 52px;\n        height: 52px;\n        display: block;\n        object-fit: contain;\n      }\n\n      .title {\n        margin: 20px 0 0;\n        font-size: 13.5px;\n        line-height: 1.18;\n        font-weight: 700;\n        letter-spacing: 0;\n      }\n\n      .meta {\n        margin-top: 28px;\n        display: flex;\n        flex-direction: column;\n        gap: 17px;\n        font-size: 13px;\n        line-height: 1.2;\n        font-weight: 400;\n        letter-spacing: 0;\n        color: #303033;\n      }\n\n\n      .ok-button {\n        width: 100%;\n        height: 36px;\n        border: 0;\n        border-radius: 18px;\n        background: var(--about-primary);\n        color: var(--about-primary-foreground);\n        font: inherit;\n        font-size: 13px;\n        font-weight: 500;\n        letter-spacing: 0;\n        outline: none;\n        cursor: default;\n        -webkit-app-region: no-drag;\n      }\n\n      .ok-button:active {\n        background: var(--about-primary-active);\n      }\n\n      @media (prefers-color-scheme: dark) {\n        :root {\n          --startup-page-bg: #171717;\n          --about-primary: #fafafa;\n          --about-primary-foreground: #0a0a0a;\n          --about-primary-active: color-mix(in oklab, var(--about-primary) 80%, transparent);\n        }\n\n        .about-card {\n          color: #e8e8e8;\n        }\n\n        .meta {\n          color: #e2e2e2;\n        }\n      }\n    </style>\n  </head>\n  <body>\n    <main class=\"about-window\" aria-label=\""
        },
        {
          "placeholder": "VALUE_2",
          "text": " About Window\">\n      <section class=\"about-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"about-title\">\n        <div class=\"content\">\n          <img class=\"app-icon\" src=\""
        },
        {
          "placeholder": "VALUE_3",
          "text": "\" alt=\"\" />\n          <h1 id=\"about-title\" class=\"title\">\n            "
        },
        {
          "placeholder": "VALUE_4",
          "text": "<br />\n            "
        },
        {
          "placeholder": "VALUE_5",
          "text": " "
        },
        {
          "placeholder": "VALUE_6",
          "text": "\n          </h1>\n          <div class=\"meta\">\n            "
        },
        {
          "placeholder": "VALUE_7",
          "text": "\n            <div>"
        },
        {
          "placeholder": "VALUE_8",
          "text": "</div>\n          </div>\n        </div>\n        <div class=\"spacer\"></div>\n        <button class=\"ok-button\" type=\"button\" autofocus>"
        },
        {
          "placeholder": "VALUE_9",
          "text": "</button>\n      </section>\n    </main>\n    \n  </body>\n</html>"
        }
      ]
    },
