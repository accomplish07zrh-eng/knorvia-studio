# Knorvia Studio: optional local development settings.
KNORVIA_ENV=production
# Full app-owned directory. Leave unset to use the selected app profile.
KNORVIA_HOME=
# Parent portable folder; data is created inside it. Packaged portable builds carry a marker.
KNORVIA_PORTABLE_DIR=
# Explicit optional asset mirrors only; no upstream product server is configured.
KNORVIA_CDN_BASE_URL=
KNORVIA_REMOTE_ASSET_CDN_BASE_URL=
KNORVIA_DEPS_BASE_URL=
