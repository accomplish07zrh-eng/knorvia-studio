{
  "name": "@knorvia/node-repl-host",
  "private": true,
  "version": "0.7.0",
  "description": "Knorvia isolated JavaScript execution host and authenticated local bridges.",
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./cua-bridge": "./src/cua-bridge.ts",
    "./browser-bridge": "./src/browser-bridge.ts",
    "./cua-broker": "./src/cua-broker.ts",
