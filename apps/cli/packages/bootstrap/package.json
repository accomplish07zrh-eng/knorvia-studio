{
  "name": "@knorvia/bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./storage-startup": {
      "types": "./dist/storage-startup-entrypoint.d.ts",
      "import": "./dist/storage-startup-entrypoint.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v4-replay": {
      "types": "./dist/protocol-v4/replay.d.ts",
      "import": "./dist/protocol-v4/replay.js"
    },
    "./kernel-engine": {
      "types": "./dist/kernel/engine.d.ts",
      "import": "./dist/kernel/engine.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js"
    },
    "./kernel/runtime-context": {
      "types": "./dist/kernel/runtime-context.d.ts",
      "import": "./dist/kernel/runtime-context.js"
    },
    "./kernel-plugin-credentials": {
      "types": "./dist/kernel-plugin-credentials/index.d.ts",
      "import": "./dist/kernel-plugin-credentials/index.js"
    },
    "./kernel/shell-environment-bash": {
      "types": "./dist/kernel/shell-environment-bash.d.ts",
      "import": "./dist/kernel/shell-environment-bash.js"
    },
    "./kernel/shell-environment-pwsh": {
      "types": "./dist/kernel/shell-environment-pwsh.d.ts",
      "import": "./dist/kernel/shell-environment-pwsh.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
