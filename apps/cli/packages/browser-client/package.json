{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@knorvia/browser-client",
  "version": "0.1.0",
  "private": true,
  "description": "Knorvia browser client: facade, Playwright adapter and API policy over the browser-control protocol.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --no-ignore",
    "test": "node --experimental-test-module-mocks --import tsx --test --test-timeout=60000 test/*.test.ts"
  },
  "dependencies": {
    "@knorvia/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
