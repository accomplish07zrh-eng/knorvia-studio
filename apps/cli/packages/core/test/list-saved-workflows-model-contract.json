  "declaration": "import type { ToolEntry } from \"../types.js\";\nexport declare const listSavedWorkflowsToolEntry: ToolEntry;\n//# sourceMappingURL=list-saved-workflows.d.ts.map",
  "metadata": {
    "capability": "List the reusable dynamic-workflow definitions saved in this project",
    "metadata": {
      "name": "ListSavedWorkflows",
      "description": "Lists the dynamic workflows saved in this project (`.knorvia-studio/workflows/`, keyed on the session's working directory) and the global archive (`~/.knorvia-studio/workflows`, available from every project). These are workflow DEFINITIONS you can run, not past runs — for the run history use ListWorkflowRuns instead.\n\n- Each row gives the name, what the workflow does, when to reach for it, and the arguments it takes.\n- Run one by passing its name to CreateWorkflow as `saved: { name, args }`. The user still confirms the run.\n- Check here before writing a workflow from scratch: if the project already saved one that fits, running it beats rebuilding it.\n- `invalid` lists saved files that could not be read (usually a hand-edited metadata block). They are named so they can be fixed, not silently skipped.",
      "readOnly": true,
      "destructive": false,
      "concurrentSafe": true,
      "timeoutMs": 10000,
      "maxOutputBytes": 24000,
      "sideEffectScope": "none",
      "riskLevel": "low",
      "needsApproval": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "whenToUse": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["string", "number", "boolean", "json"],
                      "description": "Value type. \"json\" accepts any JSON value without further checking."
                    },
                    "description": {
                      "type": "string",
                      "description": "What this argument means, for whoever calls the workflow later."
                    },
                    "required": {
                      "type": "boolean",
                      "description": "When true the workflow cannot run without this argument."
                    },
                    "default": {
                      "description": "Value used when the caller omits this argument."
                    }
                  },
                  "required": ["type"],
                  "additionalProperties": false
                },
                "propertyNames": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "string",
                "enum": ["project", "global"]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name", "description", "scope", "path"],
            "additionalProperties": false
          }
        },
        "invalid": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["path", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["workflows"],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "permission": {
      "permission": "listSavedWorkflows",
      "reason": "ListSavedWorkflows reads the saved workflow definitions of the current project",
      "riskLevel": "low",
      "sideEffectScope": "none",
      "needsApproval": false,
      "patternSources": ["toolName"],
      "alwaysAllowPatternSources": ["toolName"],
      "denyPriority": "beforeAsk"
    },
    "resultBudget": {
      "maxInlineBytes": 24000,
      "maxModelBytes": 24000,
      "strategy": "truncate",
      "preview": {
        "maxBytes": 24000,
        "direction": "head"
      }
    },
    "timeout": {
      "kind": "timed",
      "defaultMs": 10000,
      "maxMs": 10000,
      "allowCallOverride": false
    },
    "cancellation": {
      "supported": false,
      "cleanup": "none",
      "userVisibleMessage": "ListSavedWorkflows scans the project's workflow directory synchronously and cannot be cancelled"
    },
    "trace": {
      "required": true,
      "propagateToAdapters": false,
      "recordInput": "summary",
      "recordOutput": "summary"
    }
  },
  "ordinary": {
    "success": true,
    "model": "<saved_workflows count=\"1\">\n<workflow name=\"synthetic&lt;&amp;&quot;\" scope=\"project\">\n  Synthetic description\nsecond line\n  When to use: \n  arg z (json, required, default null) — \n  arg a (boolean, default false)\n  arg n (number, default 0)\n  arg synthetic (json, default \"synthetic default\")\n</workflow>\n</saved_workflows>",
    "tape": ["then", "then", "then", "workflows", "invalid"]
  }
}
