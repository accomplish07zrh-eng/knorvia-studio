{
  "compilerOptions": {
    "allowJs": false,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@knorvia/provider": ["../../../../../../packages/provider/dist/index.d.ts"],
      "@knorvia/shared": ["../../../../../../packages/shared/dist/index.d.ts"],
      "@knorvia/shared/*": [
        "../../../../../../packages/shared/dist/*/index.d.ts",
        "../../../../../../packages/shared/dist/*.d.ts"
      ],
      "@target/*": ["../../dist/model/*.d.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["../model-subsystem-contract.test.ts", "cases/**/*.ts", "harness/**/*.ts"]
}
