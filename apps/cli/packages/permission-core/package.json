{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@knorvia/permission-core",
  "version": "0.1.0",
  "private": true,
  "description": "Knorvia permission runtime: the preparation lifecycle (prepare / activate / dispose) shared by the agent runtime, the protocol bridge and the clients.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --no-ignore"
  },
  "dependencies": {
    "@knorvia/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
