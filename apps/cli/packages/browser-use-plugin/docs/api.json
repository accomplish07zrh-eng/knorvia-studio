  ],
  "semantics": {
    "scope": "Select only a backend reported by the current host. Every call has a fresh execution context.",
    "verification": "Observe the page before targeting controls and after changing state. Match tabs by verified identity.",
    "errors": "SDK failures throw; unavailable capabilities are hidden. Do not report success after an exception."
  },
